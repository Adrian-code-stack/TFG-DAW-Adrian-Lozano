---
import Layout from "../../layouts/Layout.astro";
import { fetchJSON } from "../../lib/api";

export const prerender = false;

const { slug } = Astro.params;

let article: any = null;
let ui: any = {};

try {
  const res = await fetchJSON("/api/articles/" + slug);
  article = res?.data ?? null;
} catch (e) {}

try {
  const pageRes = await fetchJSON("/api/article-page");
  const p = pageRes?.data ?? {};
  ui = {
    backLabel:         p.backLabel         ?? "← Volver a artículos",
    notFoundTitle:     p.notFoundTitle     ?? "Artículo no encontrado",
    notFoundSub:       p.notFoundSub       ?? "",
    notFoundBtn:       p.notFoundBtn       ?? "Ver todos los artículos",
    readingTimeSuffix: p.readingTimeSuffix ?? "min de lectura",
  };
} catch (e) {
  ui = {
    backLabel: "← Volver a artículos",
    notFoundTitle: "Artículo no encontrado",
    notFoundSub: "",
    notFoundBtn: "Ver todos los artículos",
    readingTimeSuffix: "min de lectura",
  };
}

const d = article;

function calcReadingTime(text: string): number {
  if (!text) return 1;
  const words = text.replace(/<[^>]*>/g, "").split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 200));
}

function parseContent(raw: string): { type: string; text: string }[] {
  if (!raw) return [];
  return raw.split("\n\n").filter(Boolean).map(t => ({ type: "paragraph", text: t.trim() }));
}

const title       = d?.title ?? "";
const author      = d?.author ?? null;
const publishedAt = d?.publishedAt ?? null;
const coverUrl    = d?.cover_url ?? null;
const contentRaw  = d?.content ?? "";
const blocks      = parseContent(contentRaw);
const readingTime = d?.readingTime ?? calcReadingTime(contentRaw);
const excerpt     = d?.excerpt ?? contentRaw.slice(0, 155);
const pageTitle   = d ? "GameVault | " + title : "GameVault | Artículo no encontrado";

function formatDate(dateStr: string | null): string | null {
  if (!dateStr) return null;
  const dt = new Date(dateStr);
  if (isNaN(dt.getTime())) return null;
  return dt.toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" });
}
const date = formatDate(publishedAt);
const introBlock = blocks[0];
const bodyBlocks  = blocks.slice(1);
---

<Layout title={pageTitle} description={excerpt} image={coverUrl ?? undefined}>

  <div id="reading-progress-bar" style="position:fixed;top:0;left:0;height:3px;width:0%;background:linear-gradient(90deg,#7c3aed,#a855f7);z-index:9999;transition:width 0.1s linear;border-radius:0 2px 2px 0;"></div>

  <div class="min-h-screen bg-zinc-950 text-zinc-100">

    {!d && (
      <div class="max-w-2xl mx-auto px-6 py-32 text-center">
        <h1 class="text-3xl font-bold text-white mb-3">{ui.notFoundTitle}</h1>
        <p class="text-zinc-400 mb-8">{ui.notFoundSub}</p>
        <a href="/articles" class="inline-flex items-center gap-2 bg-violet-600 hover:bg-violet-500 text-white font-semibold px-6 py-3 rounded-xl transition-all text-sm">
          {ui.notFoundBtn}
        </a>
      </div>
    )}

    {d && (
      <div>
        <div class="max-w-3xl mx-auto px-6 pt-8">
          <a href="/articles" class="inline-flex items-center gap-1.5 text-sm text-zinc-500 hover:text-violet-400 transition-colors">
            {ui.backLabel}
          </a>
        </div>

        <article id="article-content" class="max-w-3xl mx-auto px-6 py-10">

          <div class="flex flex-wrap items-center gap-3 mb-6">
            {author && (
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-zinc-400 bg-zinc-900 border border-zinc-800 px-3 py-1.5 rounded-full">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                {author}
              </span>
            )}
            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-violet-400 bg-violet-950/40 border border-violet-800/40 px-3 py-1.5 rounded-full">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              {readingTime} {ui.readingTimeSuffix}
            </span>
            {date && <span class="text-xs text-zinc-600 font-medium">{date}</span>}
          </div>

          <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-white mb-6 leading-tight">{title}</h1>

          {introBlock && (
            <p class="text-lg text-zinc-300 leading-relaxed mb-8 border-l-4 border-violet-600 pl-5 italic">
              {introBlock.text}
            </p>
          )}

          {coverUrl && (
            <div class="rounded-2xl overflow-hidden border border-zinc-800 mb-10">
              <img src={coverUrl} alt={"Imagen del artículo: " + title} class="w-full h-72 object-cover" loading="lazy" />
            </div>
          )}

          <div class="flex items-center gap-3 my-8">
            <div class="h-px flex-1 bg-zinc-800"></div>
            <div class="w-1.5 h-1.5 rounded-full bg-violet-600"></div>
            <div class="w-1 h-1 rounded-full bg-zinc-600"></div>
            <div class="h-px flex-1 bg-zinc-800"></div>
          </div>

          {bodyBlocks.length > 0 && (
            <div class="space-y-5">
              {bodyBlocks.map((block) => (
                <p class="text-zinc-400 leading-relaxed text-base">{block.text}</p>
              ))}
            </div>
          )}

          <div class="mt-16 pt-8 border-t border-zinc-800 flex items-center justify-between flex-wrap gap-4">
            <a href="/articles" class="inline-flex items-center gap-2 text-sm font-semibold text-violet-400 hover:text-violet-300 transition-colors">
              {ui.backLabel}
            </a>
            <span class="text-xs text-zinc-600">{readingTime} {ui.readingTimeSuffix} · GameVault</span>
          </div>
        </article>
      </div>
    )}
  </div>
</Layout>

<script>
  const bar     = document.getElementById("reading-progress-bar");
  const article = document.getElementById("article-content");
  if (bar && article) {
    window.addEventListener("scroll", () => {
      const { top, height } = article.getBoundingClientRect();
      const articleStart  = top + window.scrollY;
      const scrolled      = window.scrollY - articleStart;
      const scrollable    = height - window.innerHeight;
      const pct = Math.min(100, Math.max(0, (scrolled / scrollable) * 100));
      bar.style.width = pct + "%";
      bar.style.background = pct >= 100
        ? "linear-gradient(90deg,#16a34a,#22c55e)"
        : "linear-gradient(90deg,#7c3aed,#a855f7)";
    }, { passive: true });
  }
</script>
