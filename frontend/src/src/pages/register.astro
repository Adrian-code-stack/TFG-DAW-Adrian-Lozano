---
import Layout from "../layouts/Layout.astro";
---

<Layout title="GameVault | Crear cuenta">
  <div class="min-h-screen bg-zinc-950 flex items-center justify-center px-4 py-20">
    <div class="w-full max-w-md">

      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2 mb-6">
          <div class="w-10 h-10 bg-violet-600 rounded-xl flex items-center justify-center">
            <span class="text-white font-black text-lg">G</span>
          </div>
          <span class="text-xl font-black text-white">GameVault</span>
        </a>
        <h1 class="text-3xl font-extrabold text-white mb-2">Crea tu cuenta</h1>
        <p class="text-zinc-400 text-sm">Únete a la comunidad GameVault</p>
      </div>

      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-8">
        <form id="register-form" class="space-y-5">

          <div>
            <label class="block text-sm font-semibold text-zinc-300 mb-2">Nombre de usuario</label>
            <input id="username" type="text" placeholder="tuusername" required minlength={3} maxlength={50} autocomplete="username"
              class="w-full bg-zinc-800 border border-zinc-700 rounded-xl text-sm text-zinc-100 placeholder-zinc-600 px-4 py-3 outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500/30 transition-all" />
          </div>

          <div>
            <label class="block text-sm font-semibold text-zinc-300 mb-2">Email</label>
            <input id="email" type="email" placeholder="tu@email.com" required autocomplete="email"
              class="w-full bg-zinc-800 border border-zinc-700 rounded-xl text-sm text-zinc-100 placeholder-zinc-600 px-4 py-3 outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500/30 transition-all" />
          </div>

          <div>
            <label class="block text-sm font-semibold text-zinc-300 mb-2">Contraseña</label>
            <div class="relative">
              <input id="password" type="password" placeholder="Mínimo 6 caracteres" required minlength={6} autocomplete="new-password"
                class="w-full bg-zinc-800 border border-zinc-700 rounded-xl text-sm text-zinc-100 placeholder-zinc-600 px-4 py-3 pr-11 outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500/30 transition-all" />
              <button type="button" id="toggle-password" class="absolute right-3 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              </button>
            </div>
          </div>

          <div id="register-error" class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl"></div>
          <div id="register-success" class="hidden bg-green-500/10 border border-green-500/30 text-green-400 text-sm px-4 py-3 rounded-xl"></div>

          <button type="submit" id="btn-submit"
            class="w-full bg-violet-600 hover:bg-violet-500 text-white font-bold py-3 rounded-xl transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-violet-500/25 text-sm">
            Crear cuenta
          </button>
        </form>

        <div class="mt-6 pt-6 border-t border-zinc-800 text-center">
          <p class="text-zinc-500 text-sm">
            ¿Ya tienes cuenta?
            <a href="/login" class="text-violet-400 hover:text-violet-300 font-semibold ml-1 transition-colors">Inicia sesión</a>
          </p>
        </div>
      </div>

      <p class="text-center text-xs text-zinc-600 mt-6">
        Al registrarte aceptas que tus datos se usarán para gestionar tu cuenta en GameVault, conforme al RGPD.
      </p>
    </div>
  </div>
</Layout>

<script>
  const form       = document.getElementById("register-form");
  const errorEl    = document.getElementById("register-error");
  const successEl  = document.getElementById("register-success");
  const btnSub     = document.getElementById("btn-submit");
  const togglePwd  = document.getElementById("toggle-password");
  const pwdInput   = document.getElementById("password") as HTMLInputElement;

  togglePwd?.addEventListener("click", () => {
    pwdInput.type = pwdInput.type === "password" ? "text" : "password";
  });

  if (localStorage.getItem("gv-token")) window.location.href = "/";

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl?.classList.add("hidden");
    successEl?.classList.add("hidden");
    btnSub.textContent = "Creando cuenta...";
    btnSub.setAttribute("disabled", "true");

    const username = (document.getElementById("username") as HTMLInputElement).value.trim();
    const email    = (document.getElementById("email")    as HTMLInputElement).value.trim();
    const password = pwdInput.value;

    try {
      const res  = await fetch("/api/auth/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ username, email, password }),
      });
      const data = await res.json();

      if (res.ok) {
        successEl.textContent = "¡Cuenta creada! Redirigiendo al login...";
        successEl?.classList.remove("hidden");
        setTimeout(() => window.location.href = "/login", 1500);
      } else {
        const msg = data.errors?.[0]?.msg ?? data.error ?? "Error al crear la cuenta.";
        errorEl.textContent = msg;
        errorEl?.classList.remove("hidden");
        btnSub.textContent = "Crear cuenta";
        btnSub.removeAttribute("disabled");
      }
    } catch (err) {
      errorEl.textContent = "Error de conexión. Inténtalo de nuevo.";
      errorEl?.classList.remove("hidden");
      btnSub.textContent = "Crear cuenta";
      btnSub.removeAttribute("disabled");
    }
  });
</script>
