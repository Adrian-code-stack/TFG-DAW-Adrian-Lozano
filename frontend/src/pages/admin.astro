---
import Layout from "../layouts/Layout.astro";
---

<Layout title="GameVault | Panel de Administración">
  <div class="min-h-screen bg-zinc-950 text-zinc-100">

    <!-- Header -->
    <div class="border-b border-zinc-800/60 bg-zinc-900/50">
      <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-violet-600 rounded-lg flex items-center justify-center">
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <div>
            <h1 class="text-lg font-bold text-white">Panel de Administración</h1>
            <p class="text-xs text-zinc-500">GameVault</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span id="admin-user" class="text-sm text-zinc-400"></span>
          <a href="/" class="text-sm text-violet-400 hover:text-violet-300 transition-colors">← Volver a la web</a>
        </div>
      </div>
    </div>

    <!-- Auth check -->
    <div id="not-admin" class="hidden max-w-2xl mx-auto px-6 py-32 text-center">
      <h2 class="text-2xl font-bold text-white mb-3">Acceso restringido</h2>
      <p class="text-zinc-400 mb-6">Necesitas iniciar sesión como administrador para acceder a este panel.</p>
      <a href="/login" class="bg-violet-600 hover:bg-violet-500 text-white font-semibold px-6 py-3 rounded-xl text-sm transition-all">Iniciar sesión</a>
    </div>

    <div id="admin-panel" class="hidden max-w-6xl mx-auto px-6 py-10">

      <!-- Estadisticas -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 text-center">
          <p class="text-3xl font-black text-violet-400" id="stat-games">—</p>
          <p class="text-xs text-zinc-500 mt-1">Juegos</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 text-center">
          <p class="text-3xl font-black text-violet-400" id="stat-cats">—</p>
          <p class="text-xs text-zinc-500 mt-1">Categorías</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 text-center">
          <p class="text-3xl font-black text-violet-400" id="stat-articles">—</p>
          <p class="text-xs text-zinc-500 mt-1">Artículos</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 text-center">
          <p class="text-3xl font-black text-violet-400" id="stat-users">—</p>
          <p class="text-xs text-zinc-500 mt-1">Usuarios</p>
        </div>
      </div>

      <!-- Apartados -->
      <div class="flex gap-2 mb-8 border-b border-zinc-800">
        {["juegos", "articulos", "usuarios"].map((tab) => (
          <button class="tab-btn px-5 py-3 text-sm font-semibold transition-colors border-b-2 -mb-px capitalize"
            data-tab={tab}>
            {tab === "juegos" ? "Juegos" : tab === "articulos" ? "Artículos" : "Usuarios"}
          </button>
        ))}
      </div>

      <!-- Apartado Juegos -->
      <div id="tab-juegos" class="tab-content">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

          <!-- Añadir juego -->
          <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
            <h2 class="text-lg font-bold text-white mb-5 flex items-center gap-2">
              <span class="w-6 h-6 bg-violet-600 rounded-lg flex items-center justify-center text-xs">+</span>
              Añadir juego
            </h2>
            <form id="form-game" class="space-y-4">
              <div>
                <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Título *</label>
                <input id="game-title" type="text" placeholder="Ej: Elden Ring"
                  class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder-zinc-600 focus:outline-none focus:border-violet-500 transition-colors" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Slug *</label>
                <input id="game-slug" type="text" placeholder="elden-ring"
                  class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder-zinc-600 focus:outline-none focus:border-violet-500 transition-colors" />
                <p class="text-xs text-zinc-600 mt-1">Solo minúsculas, números y guiones</p>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Categoría</label>
                  <select id="game-category"
                    class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-sm text-zinc-300 focus:outline-none focus:border-violet-500 transition-colors">
                    <option value="">Sin categoría</option>
                  </select>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Fecha lanzamiento</label>
                  <input id="game-date" type="date"
                    class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-sm text-zinc-300 focus:outline-none focus:border-violet-500 transition-colors" />
                </div>
              </div>
              <div>
                <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Descripción (opcional)</label>
                <textarea id="game-desc" rows={3} placeholder="Descripción editorial en español..."
                  class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder-zinc-600 focus:outline-none focus:border-violet-500 transition-colors resize-none"></textarea>
              </div>
              <div class="bg-violet-950/30 border border-violet-800/40 rounded-xl p-3">
                <p class="text-xs text-violet-300 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
                  Los datos de RAWG (portada, nota, screenshots, vídeo) se importan automáticamente al guardar.
                </p>
              </div>
              <div id="game-msg" class="hidden text-sm px-4 py-2.5 rounded-xl"></div>
              <button type="submit" id="btn-game"
                class="w-full bg-violet-600 hover:bg-violet-500 text-white font-semibold py-3 rounded-xl text-sm transition-all flex items-center justify-center gap-2">
                <span id="btn-game-text">Crear juego</span>
                <svg id="btn-game-spin" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
              </button>
            </form>
          </div>

          <!-- Lista juegos -->
          <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-lg font-bold text-white">Juegos en el catálogo</h2>
              <input id="search-games" type="text" placeholder="Buscar..."
                class="bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-xs text-zinc-300 placeholder-zinc-600 focus:outline-none focus:border-violet-500 w-32 transition-colors" />
            </div>
            <div id="games-list" class="space-y-2 max-h-[480px] overflow-y-auto pr-1"></div>
          </div>
        </div>
      </div>

      <!-- Apartado Articulos -->
      <div id="tab-articulos" class="tab-content hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

          <!-- Añadir articulo -->
          <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
            <h2 class="text-lg font-bold text-white mb-5 flex items-center gap-2">
              <span class="w-6 h-6 bg-violet-600 rounded-lg flex items-center justify-center text-xs">+</span>
              Nuevo artículo
            </h2>
            <form id="form-article" class="space-y-4">
              <div>
                <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Título *</label>
                <input id="art-title" type="text" placeholder="Título del artículo"
                  class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder-zinc-600 focus:outline-none focus:border-violet-500 transition-colors" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Slug *</label>
                <input id="art-slug" type="text" placeholder="titulo-del-articulo"
                  class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder-zinc-600 focus:outline-none focus:border-violet-500 transition-colors" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Resumen</label>
                <input id="art-excerpt" type="text" placeholder="Breve descripción para la tarjeta"
                  class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder-zinc-600 focus:outline-none focus:border-violet-500 transition-colors" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Contenido *</label>
                <textarea id="art-content" rows={5} placeholder="Escribe el contenido del artículo..."
                  class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder-zinc-600 focus:outline-none focus:border-violet-500 transition-colors resize-none"></textarea>
              </div>
              <div>
                <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">URL de portada</label>
                <input id="art-cover" type="text" placeholder="https://..."
                  class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder-zinc-600 focus:outline-none focus:border-violet-500 transition-colors" />
              </div>
              <div id="art-msg" class="hidden text-sm px-4 py-2.5 rounded-xl"></div>
              <button type="submit" id="btn-article"
                class="w-full bg-violet-600 hover:bg-violet-500 text-white font-semibold py-3 rounded-xl text-sm transition-all flex items-center justify-center gap-2">
                <span>Publicar artículo</span>
              </button>
            </form>
          </div>

          <!-- Lista articulos -->
          <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
            <h2 class="text-lg font-bold text-white mb-4">Artículos publicados</h2>
            <div id="articles-list" class="space-y-2 max-h-[480px] overflow-y-auto pr-1"></div>
          </div>
        </div>
      </div>

      <!-- Apartdo Usuarios -->
      <div id="tab-usuarios" class="tab-content hidden">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
          <h2 class="text-lg font-bold text-white mb-5">Usuarios registrados</h2>
          <div id="users-list" class="space-y-2"></div>
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
  const token = localStorage.getItem("gv-token");
  const user  = JSON.parse(localStorage.getItem("gv-user") || "null");
  const ROLE_LEVELS: Record<string,number> = { reader:1, editor:2, admin:3, superadmin:4 };
  const isAdmin = token && user && ROLE_LEVELS[user.role] >= 3;

  if (!isAdmin) {
    document.getElementById("not-admin")!.classList.remove("hidden");
  } else {
    document.getElementById("admin-panel")!.classList.remove("hidden");
    document.getElementById("admin-user")!.textContent = user.username + " (" + user.role + ")";
    init();
  }

  async function api(path: string, opts: RequestInit = {}) {
    const res = await fetch(path, {
      ...opts,
      headers: { "Content-Type":"application/json", "Authorization":"Bearer "+token, ...(opts.headers||{}) }
    });
    return res.json().then(d => ({ ok: res.ok, status: res.status, ...d }));
  }

  // ── Apartados ─────────────────────────────────────────────────────────────────
  const tabs = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  tabs.forEach(btn => {
    btn.addEventListener("click", () => {
      tabs.forEach(b => {
        b.classList.remove("border-violet-500","text-violet-400");
        b.classList.add("border-transparent","text-zinc-500");
      });
      btn.classList.add("border-violet-500","text-violet-400");
      btn.classList.remove("border-transparent","text-zinc-500");
      document.querySelectorAll(".tab-content").forEach(t => t.classList.add("hidden"));
      document.getElementById("tab-"+btn.dataset.tab)!.classList.remove("hidden");
    });
  });
  tabs[0].click();

  // ── INIT ──────────────────────────────────────────────────────────────────
  async function init() {
    const [gRes, cRes, aRes, uRes] = await Promise.all([
      api("/api/games"),
      api("/api/categories"),
      api("/api/articles"),
      api("/api/users"),
    ]);

    const games      = gRes.data      ?? [];
    const categories = cRes.data      ?? [];
    const articles   = aRes.data      ?? [];
    const users      = uRes.data      ?? [];

    document.getElementById("stat-games")!.textContent    = String(games.length);
    document.getElementById("stat-cats")!.textContent     = String(categories.length);
    document.getElementById("stat-articles")!.textContent = String(articles.length);
    document.getElementById("stat-users")!.textContent    = String(users.length);

    // Select de Categorias
    const sel = document.getElementById("game-category") as HTMLSelectElement;
    categories.forEach((c: any) => {
      const opt = document.createElement("option");
      opt.value = c.id;
      opt.textContent = c.name;
      sel.appendChild(opt);
    });

    renderGames(games);
    renderArticles(articles);
    renderUsers(users);
  }

  // ── AUTO SLUG ──────────────────────────────────────────────────────────────
  function toSlug(str: string) {
    return str.toLowerCase()
      .replace(/[áàäâ]/g,"a").replace(/[éèëê]/g,"e").replace(/[íìïî]/g,"i")
      .replace(/[óòöô]/g,"o").replace(/[úùüû]/g,"u").replace(/ñ/g,"n")
      .replace(/[^a-z0-9]+/g,"-").replace(/^-+|-+$/g,"");
  }
  (document.getElementById("game-title") as HTMLInputElement).addEventListener("input", e => {
    const slugEl = document.getElementById("game-slug") as HTMLInputElement;
    if (!slugEl.dataset.manual) slugEl.value = toSlug((e.target as HTMLInputElement).value);
  });
  (document.getElementById("game-slug") as HTMLInputElement).addEventListener("input", e => {
    (e.target as HTMLInputElement).dataset.manual = "1";
  });
  (document.getElementById("art-title") as HTMLInputElement).addEventListener("input", e => {
    const slugEl = document.getElementById("art-slug") as HTMLInputElement;
    if (!slugEl.dataset.manual) slugEl.value = toSlug((e.target as HTMLInputElement).value);
  });
  (document.getElementById("art-slug") as HTMLInputElement).addEventListener("input", e => {
    (e.target as HTMLInputElement).dataset.manual = "1";
  });

  // ── CREAR JUEGO ────────────────────────────────────────────────────────────
  document.getElementById("form-game")!.addEventListener("submit", async e => {
    e.preventDefault();
    const title    = (document.getElementById("game-title") as HTMLInputElement).value.trim();
    const slug     = (document.getElementById("game-slug") as HTMLInputElement).value.trim();
    const desc     = (document.getElementById("game-desc") as HTMLTextAreaElement).value.trim();
    const date     = (document.getElementById("game-date") as HTMLInputElement).value;
    const catId    = (document.getElementById("game-category") as HTMLSelectElement).value;
    const msgEl    = document.getElementById("game-msg")!;
    const btnText  = document.getElementById("btn-game-text")!;
    const btnSpin  = document.getElementById("btn-game-spin")!;

    if (!title || !slug) { showMsg(msgEl, "El título y el slug son obligatorios.", false); return; }

    btnText.textContent = "Importando RAWG...";
    btnSpin.classList.remove("hidden");
    msgEl.classList.add("hidden");
    (document.getElementById("btn-game") as HTMLButtonElement).disabled = true;

    const res = await api("/api/games", {
      method:"POST",
      body: JSON.stringify({ title, slug, description: desc||undefined, release_date: date||undefined, category_id: catId||undefined })
    });

    btnSpin.classList.add("hidden");
    (document.getElementById("btn-game") as HTMLButtonElement).disabled = false;
    btnText.textContent = "Crear juego";

    if (res.ok) {
      showMsg(msgEl, "✅ Juego creado" + (res.rawgEnriched ? " y enriquecido con RAWG" : "") + ". Actualiza la lista.", true);
      (document.getElementById("form-game") as HTMLFormElement).reset();
      const gRes = await api("/api/games");
      renderGames(gRes.data ?? []);
      document.getElementById("stat-games")!.textContent = String((gRes.data??[]).length);
    } else {
      showMsg(msgEl, res.error ?? res.errors?.[0]?.msg ?? "Error al crear el juego.", false);
    }
  });

  // ── CREAR ARTICULO ─────────────────────────────────────────────────────────
  document.getElementById("form-article")!.addEventListener("submit", async e => {
    e.preventDefault();
    const title   = (document.getElementById("art-title")   as HTMLInputElement).value.trim();
    const slug    = (document.getElementById("art-slug")    as HTMLInputElement).value.trim();
    const excerpt = (document.getElementById("art-excerpt") as HTMLInputElement).value.trim();
    const content = (document.getElementById("art-content") as HTMLTextAreaElement).value.trim();
    const cover   = (document.getElementById("art-cover")   as HTMLInputElement).value.trim();
    const msgEl   = document.getElementById("art-msg")!;

    if (!title || !slug || !content) { showMsg(msgEl, "Título, slug y contenido son obligatorios.", false); return; }

    const res = await api("/api/articles", {
      method:"POST",
      body: JSON.stringify({ title, slug, excerpt: excerpt||undefined, content, cover_url: cover||undefined, publish: true })
    });

    if (res.ok) {
      showMsg(msgEl, "✅ Artículo publicado correctamente.", true);
      (document.getElementById("form-article") as HTMLFormElement).reset();
      const aRes = await api("/api/articles");
      renderArticles(aRes.data ?? []);
      document.getElementById("stat-articles")!.textContent = String((aRes.data??[]).length);
    } else {
      showMsg(msgEl, res.error ?? res.errors?.[0]?.msg ?? "Error al publicar.", false);
    }
  });

  // ── RENDER JUEGOS ──────────────────────────────────────────────────────────
  let allGames: any[] = [];
  function renderGames(games: any[]) {
    allGames = games;
    displayGames(games);
  }
  function displayGames(games: any[]) {
    const el = document.getElementById("games-list")!;
    if (!games.length) { el.innerHTML = '<p class="text-zinc-600 text-sm text-center py-6">No hay juegos.</p>'; return; }
    el.innerHTML = games.map(g => `
      <div class="flex items-center gap-3 bg-zinc-800/50 border border-zinc-700/50 rounded-xl p-3 group">
        ${g.cover_url ? `<img src="${g.cover_url}" class="w-10 h-10 rounded-lg object-cover shrink-0" />` : '<div class="w-10 h-10 rounded-lg bg-zinc-700 flex items-center justify-center text-lg shrink-0">🎮</div>'}
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-zinc-100 truncate">${g.title}</p>
          <p class="text-xs text-zinc-500">${g.category?.name ?? "Sin categoría"} ${g.rawg_rating ? "· ★ "+g.rawg_rating : ""}</p>
        </div>
        <div class="flex gap-1 shrink-0">
          <a href="/games/${g.slug}" target="_blank" class="p-1.5 rounded-lg hover:bg-zinc-700 text-zinc-500 hover:text-violet-400 transition-colors" title="Ver juego">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
          <button onclick="enrichGame(${g.id})" class="p-1.5 rounded-lg hover:bg-zinc-700 text-zinc-500 hover:text-yellow-400 transition-colors" title="Reimportar RAWG">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          </button>
          <button onclick="deleteGame(${g.id},'${g.title.replace(/'/g,"&#39;")}')" class="p-1.5 rounded-lg hover:bg-zinc-700 text-zinc-500 hover:text-red-400 transition-colors" title="Eliminar">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </button>
        </div>
      </div>`).join("");
  }

  (document.getElementById("search-games") as HTMLInputElement).addEventListener("input", e => {
    const q = (e.target as HTMLInputElement).value.toLowerCase();
    displayGames(q ? allGames.filter(g => g.title.toLowerCase().includes(q)) : allGames);
  });

  (window as any).deleteGame = async (id: number, title: string) => {
    if (!confirm("¿Eliminar \"" + title + "\"?")) return;
    const res = await api("/api/games/"+id, { method:"DELETE" });
    if (res.ok) {
      const gRes = await api("/api/games");
      renderGames(gRes.data ?? []);
      document.getElementById("stat-games")!.textContent = String((gRes.data??[]).length);
    } else alert(res.error ?? "Error al eliminar.");
  };

  (window as any).enrichGame = async (id: number) => {
    const btn = event?.target as HTMLElement;
    if (btn) btn.style.opacity = "0.3";
    const res = await api("/api/games/"+id+"/enrich", { method:"POST" });
    if (btn) btn.style.opacity = "1";
    if (res.ok) {
      const gRes = await api("/api/games");
      renderGames(gRes.data ?? []);
      alert("✅ Juego actualizado con datos de RAWG.");
    } else alert(res.error ?? "No se encontraron datos en RAWG.");
  };

  // ── RENDER ARTICULOS ───────────────────────────────────────────────────────
  function renderArticles(articles: any[]) {
    const el = document.getElementById("articles-list")!;
    if (!articles.length) { el.innerHTML = '<p class="text-zinc-600 text-sm text-center py-6">No hay artículos.</p>'; return; }
    el.innerHTML = articles.map(a => `
      <div class="flex items-center gap-3 bg-zinc-800/50 border border-zinc-700/50 rounded-xl p-3">
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-zinc-100 truncate">${a.title}</p>
          <p class="text-xs text-zinc-500">${a.author ?? "Sin autor"} · ${a.publishedAt ? new Date(a.publishedAt).toLocaleDateString("es-ES") : "Borrador"}</p>
        </div>
        <div class="flex gap-1 shrink-0">
          <a href="/articles/${a.slug}" target="_blank" class="p-1.5 rounded-lg hover:bg-zinc-700 text-zinc-500 hover:text-violet-400 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
          <button onclick="deleteArticle(${a.id},'${a.title.replace(/'/g,"&#39;")}')" class="p-1.5 rounded-lg hover:bg-zinc-700 text-zinc-500 hover:text-red-400 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </button>
        </div>
      </div>`).join("");
  }

  (window as any).deleteArticle = async (id: number, title: string) => {
    if (!confirm("¿Eliminar \"" + title + "\"?")) return;
    const res = await api("/api/articles/"+id, { method:"DELETE" });
    if (res.ok) {
      const aRes = await api("/api/articles");
      renderArticles(aRes.data ?? []);
      document.getElementById("stat-articles")!.textContent = String((aRes.data??[]).length);
    } else alert(res.error ?? "Error al eliminar.");
  };

  // ── RENDER USUARIOS ────────────────────────────────────────────────────────
  const roleColors: Record<string,string> = {
    superadmin:"bg-red-500/20 text-red-400 border-red-500/30",
    admin:     "bg-yellow-500/20 text-yellow-400 border-yellow-500/30",
    editor:    "bg-violet-500/20 text-violet-400 border-violet-500/30",
    reader:    "bg-zinc-700 text-zinc-400 border-zinc-600",
  };
  function renderUsers(users: any[]) {
    const el = document.getElementById("users-list")!;
    if (!users.length) { el.innerHTML = '<p class="text-zinc-600 text-sm text-center py-6">No hay usuarios.</p>'; return; }
    el.innerHTML = users.map(u => `
      <div class="flex items-center gap-4 bg-zinc-800/50 border border-zinc-700/50 rounded-xl px-4 py-3">
        <div class="w-9 h-9 rounded-full bg-violet-600 flex items-center justify-center text-white font-black text-sm shrink-0">
          ${u.username[0].toUpperCase()}
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-zinc-100">${u.username}</p>
          <p class="text-xs text-zinc-500">${u.email}</p>
        </div>
        <span class="text-xs font-bold px-2.5 py-1 rounded-full border ${roleColors[u.role]??roleColors.reader}">${u.role}</span>
      </div>`).join("");
  }

  // ── HELPER MSG ─────────────────────────────────────────────────────────────
  function showMsg(el: HTMLElement, text: string, ok: boolean) {
    el.textContent = text;
    el.className = "text-sm px-4 py-2.5 rounded-xl " + (ok
      ? "bg-green-500/10 border border-green-500/30 text-green-400"
      : "bg-red-500/10 border border-red-500/30 text-red-400");
    el.classList.remove("hidden");
    setTimeout(() => el.classList.add("hidden"), 5000);
  }
</script>